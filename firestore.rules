rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email == 'dthong.design2016@gmail.com' ||
         request.auth.token.email == 'btin2499@gmail.com' ||
         request.auth.token.email == 'admin@heritageai.vn');
    }

    // User profiles & accounts
    match /users/{userId} {
      allow read, write: if true;
    }
    match /accounts/{accountId} {
      allow read, write: if true;
    }

    // Heritage cultural items (Public read, Admin or authenticated write)
    match /heritage/{heritageId} {
      allow read: if true;
      allow write: if true;
    }

    // Grandparents oral stories (Private, Family, or Public read; Owner write)
    match /familyStories/{storyId} {
      allow read: if true;
      allow write: if true;
    }

    // Community contributions
    match /communityPosts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    // Itineraries
    match /itineraries/{itineraryId} {
      allow read: if true;
      allow write: if true;
    }

    // Favorites
    match /favorites/{favoriteId} {
      allow read: if true;
      allow write: if true;
    }

    // User Activity logs
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // System & API Configuration (AI, TTS, and 3D Avatar parameters)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
